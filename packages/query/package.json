{
  "name": "@aeye/query",
  "version": "0.9.0",
  "description": "Query - An LLM-friendly relational query language, runtime & SQL converter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./conformance": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts && tsx scripts/check-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "examples": "tsx examples/examples.ts",
    "cli": "tsx examples/cli.ts",
    "integration": "tsx integration/run.ts",
    "integration:check": "tsx integration/run.ts --check",
    "bench:schema": "node --expose-gc --import tsx scripts/schema-bench.ts",
    "bench:leak": "node --expose-gc --import tsx scripts/schema-leak.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aeye/core": "^0.9.0",
    "@aeye/schema": "0.9.0",
    "zod": "^4.6.7",
    "@aeye/gin": "^0.9.0"
  },
  "devDependencies": {
    "@aeye/ai": "^0.9.0",
    "@aeye/aws": "^0.9.0",
    "@aeye/models": "^0.9.0",
    "@aeye/openai": "^0.9.0",
    "@aeye/openrouter": "^0.9.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "aeye-*.md"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickerMonkey/aeye.git",
    "directory": "packages/query"
  }
}
