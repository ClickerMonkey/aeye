{
  "name": "@aeye/query",
  "version": "0.3.8",
  "description": "Query - An LLM-friendly relational query language, runtime & SQL converter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "examples": "tsx examples/examples.ts",
    "cli": "tsx examples/cli.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@aeye/ai": "^0.3.8",
    "@aeye/aws": "^0.3.8",
    "@aeye/models": "^0.3.8",
    "@aeye/openai": "^0.3.8",
    "@aeye/openrouter": "^0.3.8",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "aeye-*.md"
  ],
  "license": "GPL-3.0"
}
