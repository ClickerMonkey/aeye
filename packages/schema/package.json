{
  "name": "@aeye/schema",
  "version": "0.8.1",
  "private": true,
  "description": "@aeye/schema - LLM-first schema builder (`a`): named types, refs, dynamic parts, per-model rendering and copy-light decoding. POC.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run && npm run test:types",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc -p tsconfig.typetest.json",
    "clean": "rimraf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "expect-type": "^1.3.0",
    "tsup": "^8.0.0",
    "vitest": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "DESIGN.md"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickerMonkey/aeye.git",
    "directory": "packages/schema"
  }
}
