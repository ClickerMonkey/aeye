{
  "name": "@aeye/schema",
  "version": "0.8.1",
  "private": true,
  "description": "@aeye/schema - LLM-first schema builder: named and dynamic types, per-model rendering, request-wide budgets, copy-light decoding",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run && npm run test:types",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc -p tsconfig.typetest.json",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "bench": "node --expose-gc --max-old-space-size=8192 --import tsx bench/run.ts",
    "bench:memory": "node --expose-gc --max-semi-space-size=256 --import tsx bench/memory.ts",
    "bench:equivalence": "node --import tsx bench/equivalence.ts",
    "bench:errors": "node --expose-gc --max-old-space-size=12288 --import tsx bench/errors.ts"
  },
  "keywords": [
    "ai",
    "llm",
    "schema",
    "json-schema",
    "structured-outputs",
    "tools",
    "typescript"
  ],
  "author": "ClickerMonkey",
  "dependencies": {},
  "devDependencies": {
    "@aeye/gin": "0.8.1",
    "@aeye/query": "0.8.1",
    "expect-type": "^1.3.0",
    "handlebars": "^4.7.0",
    "tinybench": "^2.9.0",
    "tsup": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist",
    "aeye-*.md"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickerMonkey/aeye.git",
    "directory": "packages/schema"
  }
}
