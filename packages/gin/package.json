{
  "name": "@aeye/gin",
  "version": "0.8.1",
  "description": "Gin - A type & expression system for LLM agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run && npm run test:types",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dump-schema": "tsx scripts/dump-schema.ts",
    "dump-code": "tsx scripts/dump-code.ts",
    "integration": "tsx integration/run.ts",
    "integration:check": "tsx integration/run.ts --check",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "test:types": "tsc -p tsconfig.typetest.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aeye/ai": "^0.8.1",
    "@aeye/core": "^0.8.1",
    "@aeye/models": "^0.8.1",
    "@aeye/openrouter": "^0.8.1",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "aeye-*.md"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickerMonkey/aeye.git",
    "directory": "packages/gin"
  }
}
