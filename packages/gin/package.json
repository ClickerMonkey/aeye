{
  "name": "@aeye/gin",
  "version": "0.3.8",
  "description": "Gin - A type & expression system for LLM agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dump-schema": "tsx scripts/dump-schema.ts",
    "dump-code": "tsx scripts/dump-code.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@aeye/core": "^0.3.8",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "files": ["dist"],
  "license": "GPL-3.0"
}
