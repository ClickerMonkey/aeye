{
  "name": "@aeye/resources",
  "version": "0.3.8",
  "description": "Extensible resource parsing, slicing, and resolution utilities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./default": {
      "import": {
        "types": "./dist/default.d.ts",
        "default": "./dist/default.js"
      },
      "require": {
        "types": "./dist/default.d.ts",
        "default": "./dist/default.js"
      },
      "default": "./dist/default.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "resources",
    "parsing",
    "embeddings",
    "typescript"
  ],
  "author": "ClickerMonkey",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClickerMonkey/aeye.git",
    "directory": "packages/resources"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/ClickerMonkey/aeye#readme",
  "bugs": {
    "url": "https://github.com/ClickerMonkey/aeye/issues"
  }
}
